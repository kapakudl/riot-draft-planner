{
  "name": "draft-lab",
  "version": "1.2.0",
  "private": true,
  "description": "League of Legends professional draft analysis desktop app",
  "author": "David Kapaku",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "papaparse": "5.7.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.davidkapaku.draftlab",
    "productName": "Draft Lab",
    "files": [
      "main.js",
      "preload.js",
      "engine.js",
      "importer.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json",
      "starter-data.json",
      "starter-roster.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
